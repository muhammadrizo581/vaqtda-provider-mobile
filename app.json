{
  "expo": {
    "name": "Vaqtda Provider",
    "slug": "vaqtda-provider-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vaqtdaprovidermobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0d12",
    "ios": {
      "bundleIdentifier": "com.vaqtda.provider",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.vaqtda.provider",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#567157",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0d12",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#4C8156"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vaqtda profil va xizmat rasmlarini tanlash uchun galereyaga ruxsat kerak.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Biznesingiz manzilini xaritada aniq belgilash uchun joylashuvga ruxsat kerak.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "378384da-4628-403f-8a00-aa49885471d0"
      }
    },
    "owner": "s0nd_x"
  }
}
